DB_HOST=127.0.0.1
DB_PORT=3307
# XAMPP MariaDB defaults commonly use root with an empty password.
# Prefer a dedicated account for anything beyond local development.
DB_USER=root
DB_PASSWORD=
DB_NAME=frederick_autocare
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=5000
API_PORT=3002
API_HOST=127.0.0.1
# Optional comma-separated frontend origins when the API is hosted on another origin.
CORS_ORIGIN=
# Local account bootstrap values. Change these before using the system.
ADMIN_EMAIL=admin@frederickauto.local
ADMIN_PASSWORD=admin123
EMPLOYEE_EMAIL=employee@frederickauto.local
EMPLOYEE_PASSWORD=employee123
SESSION_HOURS=8
